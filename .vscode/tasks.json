{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Next.js development server",
            "type": "npm",
            "script": "dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "nextjs",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> next dev$",
                    "endsPattern": "Ready in"
                }
            }
        }
    ]
}